{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [{ "open": "{", "close": "}" }, { "open": "[", "close": "]" }, { "open": "(", "close": ")" }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }, { "open": "'", "close": "'", "notIn": ["string", "comment"] }],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": { "increaseIndentPattern": "^\\s*(?:@(?:step|mode)|(?:foreach|when|while|do_while|parallel|gate|branch|otherwise)\\b).*$", "decreaseIndentPattern": "^\\s*(?:otherwise|branch)\\b.*$" },
  "folding": { "offSide": true }
}
