# Cache, retry, and secret interpolation.

@workflow 11-cache-retry-and-secret "Authenticated request with retry and cache policy"

@var base = "https://api.example.com"
@var token = "{{secret('api_token')}}"

@output body:json

@step fetch
  get {{base}}/secure/report
  header Authorization: Bearer {{token}}
  retry 3 on=[429, 500, 502, 503]
  cache ttl=300 key="secure-report"

@step write -> body
  save_json @fetch.body
